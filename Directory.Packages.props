<Project>
  <!--
    Central package versions.

    EF Core is pinned to 9.x on purpose: Pomelo.EntityFrameworkCore.MySql 9.0.0 is the newest
    stable Pomelo release and requires Microsoft.EntityFrameworkCore.Relational [9.0.0, 9.0.999].
    Move EF Core and Identity.EntityFrameworkCore to 10.x together with Pomelo once a stable
    Pomelo release for EF Core 10 is published.

    MediatR is pinned to 12.x: 12.5.0 is the last release under the Apache-2.0 license.
    Version 13.0.0 and later ship under a commercial license.
  -->
  <PropertyGroup>
    <!-- Lets the pins below override vulnerable transitive versions without a direct reference in any project. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Application -->
    <PackageVersion Include="MediatR" Version="12.5.0" />
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />

    <!-- Infrastructure -->
    <PackageVersion Include="Pomelo.EntityFrameworkCore.MySql" Version="9.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.20" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.20" />
    <!-- Reads .docx files (MIT, Microsoft). Referenced only from Infrastructure. -->
    <PackageVersion Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="9.0.20" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="9.0.20" />
    <!-- Transitive dependencies of the 9.0.20 Data Protection package carry known advisories (NU1902/NU1903, restore fails in CI).
         Referenced directly at the patched 10.0 line, which matches the net10.0 runtime. Applied as transitive pins
         (CentralPackageTransitivePinningEnabled), so no project references them directly. Drop both when Pomelo allows EF Core 10. -->
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.13" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />

    <!-- Web -->
    <PackageVersion Include="Markdig" Version="1.4.0" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Settings.Configuration" Version="10.0.1" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <PackageVersion Include="Serilog.Enrichers.Thread" Version="4.0.0" />

    <!-- Tests -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.12" />
  </ItemGroup>
</Project>
