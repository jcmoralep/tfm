@using BmadPlatform.Application.Features.Initiatives
@using BmadPlatform.Domain.Initiatives

<div class="space-y-6">
    <fieldset>
        <legend class="text-sm font-medium text-ink">¿Cómo se define la profundidad?</legend>
        <div class="mt-2 grid gap-3 sm:grid-cols-2">
            @foreach (var option in Modes)
            {
                var value = option;
                <label class="flex cursor-pointer items-start gap-3 rounded-control border border-line bg-surface-raised p-4 has-checked:border-primary has-checked:bg-primary-soft">
                    <input type="radio" name="depth-mode" class="mt-1 accent-primary"
                           checked="@(Mode == value)"
                           @onchange="() => SelectModeAsync(value)" />
                    <span>
                        <span class="block text-sm font-semibold text-ink">@InitiativeLabels.Mode(value)</span>
                        <span class="mt-0.5 block text-sm text-ink-muted">@InitiativeLabels.ModeDescription(value)</span>
                    </span>
                </label>
            }
        </div>
    </fieldset>

    @if (Mode == DepthMode.Manual)
    {
        <fieldset>
            <legend class="text-sm font-medium text-ink">Nivel de profundidad</legend>
            <div class="mt-2 grid gap-3 sm:grid-cols-3">
                @foreach (var option in Levels)
                {
                    var value = option;
                    <label class="flex cursor-pointer items-start gap-3 rounded-control border border-line bg-surface-raised p-4 has-checked:border-primary has-checked:bg-primary-soft">
                        <input type="radio" name="depth-level" class="mt-1 accent-primary"
                               checked="@(Depth == value)"
                               @onchange="() => SelectDepthAsync(value)" />
                        <span>
                            <span class="block text-sm font-semibold text-ink">@InitiativeLabels.Depth(value)</span>
                            <span class="mt-0.5 block text-xs font-medium uppercase tracking-wide text-ink-muted">Entrega</span>
                            <ul class="mt-1 list-disc space-y-0.5 pl-4 text-sm text-ink-muted">
                                @foreach (var deliverable in InitiativeLabels.Deliverables(value))
                                {
                                    <li>@deliverable</li>
                                }
                            </ul>
                        </span>
                    </label>
                }
            </div>
        </fieldset>
    }
    else if (Mode == DepthMode.Automatic)
    {
        <p class="rounded-control bg-bubble px-4 py-3 text-sm text-ink">
            El asistente sugerirá el nivel más adelante. Por ahora quedará como
            <span class="font-semibold">@InitiativeTexts.DepthPending</span>.
        </p>
    }
</div>

@code {
    private static readonly DepthMode[] Modes = [DepthMode.Manual, DepthMode.Automatic];

    private static readonly InitiativeDepth[] Levels = [InitiativeDepth.Small, InitiativeDepth.Standard, InitiativeDepth.Large];

    [Parameter]
    public DepthMode? Mode { get; set; }

    [Parameter]
    public EventCallback<DepthMode?> ModeChanged { get; set; }

    [Parameter]
    public InitiativeDepth? Depth { get; set; }

    [Parameter]
    public EventCallback<InitiativeDepth?> DepthChanged { get; set; }

    private async Task SelectModeAsync(DepthMode value)
    {
        Mode = value;
        await ModeChanged.InvokeAsync(value);

        // Automatic never keeps a level, so the selection is cleared right away.
        if (value == DepthMode.Automatic && Depth is not null)
        {
            Depth = null;
            await DepthChanged.InvokeAsync(null);
        }
    }

    private async Task SelectDepthAsync(InitiativeDepth value)
    {
        Depth = value;
        await DepthChanged.InvokeAsync(value);
    }
}
