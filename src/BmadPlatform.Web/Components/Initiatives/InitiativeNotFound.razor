@using BmadPlatform.Application.Features.Initiatives

@* Shown for unknown, deleted and foreign ids alike, so a caller cannot tell them apart. *@
<section class="rounded-card border border-line bg-surface-raised p-8 shadow-card">
    <h1 class="text-2xl font-semibold text-ink">@InitiativeTexts.NotFound</h1>
    <p class="mt-3 text-ink-muted">Es posible que se haya eliminado.</p>
    <a href="/iniciativas" class="mt-6 inline-block text-sm font-semibold text-ink underline">Volver a mis iniciativas</a>
</section>
