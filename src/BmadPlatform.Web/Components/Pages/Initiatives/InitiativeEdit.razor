@page "/iniciativas/{Id:guid}/editar"
@attribute [Authorize]
@using BmadPlatform.Application.Common.Exceptions
@using BmadPlatform.Application.Features.Initiatives
@using BmadPlatform.Application.Features.Initiatives.GetInitiative
@using BmadPlatform.Application.Features.Initiatives.UpdateInitiative
@using BmadPlatform.Domain.Initiatives
@inject IMediator Mediator
@inject NavigationManager Navigation

<PageTitle>Editar iniciativa · Plataforma BMAD</PageTitle>

@if (loading)
{
    <p class="text-sm text-ink-muted" role="status">Cargando…</p>
}
else if (notFound)
{
    <InitiativeNotFound />
}
else
{
    <a href="/iniciativas/@Id" class="text-sm font-medium text-ink-muted hover:text-ink hover:underline">← Volver a la iniciativa</a>

    <section class="mt-4 rounded-card border border-line bg-surface-raised p-6 shadow-card sm:p-8">
        <h1 class="text-2xl font-semibold text-ink">Editar iniciativa</h1>
        <p class="mt-2"><StatusBadge Status="status" /></p>

        @if (errors.Count > 0)
        {
            <div class="mt-4">
                <ErrorAlert Id="edit-errors" Messages="errors" />
            </div>
        }

        <form @onsubmit="SaveAsync" @onsubmit:preventDefault class="mt-6 space-y-6">
            <div>
                <label for="initiative-name" class="block text-sm font-medium text-ink">Nombre</label>
                <input id="initiative-name" type="text" @bind="name" @bind:event="oninput" autocomplete="off"
                       aria-required="true" aria-describedby="initiative-name-hint@(errors.Count > 0 ? " edit-errors" : null)"
                       class="mt-1.5 block w-full rounded-control border border-line bg-surface-raised px-3 py-2 text-sm text-ink" />
                <p id="initiative-name-hint" class="mt-1 text-xs text-ink-muted">Obligatorio, hasta @Initiative.NameMaxLength caracteres.</p>
            </div>

            <div>
                <label for="initiative-description" class="block text-sm font-medium text-ink">Descripción <span class="font-normal text-ink-muted">(opcional)</span></label>
                <textarea id="initiative-description" rows="5" @bind="description" @bind:event="oninput"
                          aria-describedby="initiative-description-hint"
                          class="mt-1.5 block w-full rounded-control border border-line bg-surface-raised px-3 py-2 text-sm text-ink"></textarea>
                <p id="initiative-description-hint" class="mt-1 text-xs text-ink-muted">Hasta @Initiative.DescriptionMaxLength caracteres.</p>
            </div>

            @if (depthEditable)
            {
                <DepthSelector @bind-Mode="mode" @bind-Depth="depth" />
            }
            else
            {
                <div>
                    <h2 class="text-sm font-medium text-ink">Profundidad</h2>
                    <dl id="depth-locked" class="mt-2 divide-y divide-line rounded-control border border-line text-sm">
                        <div class="px-4 py-3">
                            <dt class="text-xs font-medium uppercase tracking-wide text-ink-muted">Modo</dt>
                            <dd class="mt-1 text-ink">@InitiativeLabels.ModeSummary(mode)</dd>
                        </div>
                        <div class="px-4 py-3">
                            <dt class="text-xs font-medium uppercase tracking-wide text-ink-muted">Nivel</dt>
                            <dd class="mt-1 text-ink">@InitiativeLabels.DepthSummary(mode, depth)</dd>
                        </div>
                    </dl>
                    <p class="mt-2 text-xs text-ink-muted">
                        El modo y el nivel de profundidad solo se pueden cambiar mientras la iniciativa está en Borrador o Aclarando.
                    </p>
                </div>
            }

            <div class="flex flex-wrap items-center justify-end gap-3 pt-2">
                <a href="/iniciativas/@Id"
                   class="rounded-full border border-line bg-surface-raised px-5 py-2 text-sm font-medium text-ink hover:bg-surface">
                    Cancelar
                </a>
                <button type="submit" disabled="@busy"
                        class="rounded-full bg-primary px-5 py-2 text-sm font-semibold text-on-primary hover:bg-primary-hover disabled:opacity-60">
                    Guardar cambios
                </button>
            </div>
        </form>
    </section>
}

@code {
    private Guid? loadedId;
    private bool loading = true;
    private bool notFound;
    private bool busy;
    private IReadOnlyList<string> errors = [];

    private InitiativeStatus status;
    private string name = string.Empty;
    private string? description;
    private DepthMode? mode;
    private InitiativeDepth? depth;

    [Parameter]
    public Guid Id { get; set; }

    // Mirrors the domain rule; the handler enforces it either way.
    private bool depthEditable => status is InitiativeStatus.Draft or InitiativeStatus.Clarifying;

    protected override async Task OnParametersSetAsync()
    {
        if (loadedId == Id)
        {
            return;
        }

        loadedId = Id;
        loading = true;
        errors = [];

        var details = await Mediator.Send(new GetInitiativeQuery(Id));
        notFound = details is null;

        if (details is not null)
        {
            status = details.Status;
            name = details.Name;
            description = details.Description;
            mode = details.DepthMode;
            depth = details.Depth;
        }

        loading = false;
    }

    private async Task SaveAsync()
    {
        if (busy)
        {
            return;
        }

        busy = true;
        errors = [];

        try
        {
            await Mediator.Send(new UpdateInitiativeCommand(Id, name, description, mode, depth));
            Navigation.NavigateTo($"/iniciativas/{Id}");
        }
        catch (Exception exception) when (UserMessages.TryGet(exception, out var messages))
        {
            errors = messages;
            notFound = exception is NotFoundException;
        }
        finally
        {
            busy = false;
        }
    }
}
