@page "/iniciativas/{Id:guid}"
@attribute [Authorize]
@using BmadPlatform.Application.Common.Exceptions
@using BmadPlatform.Application.Features.Initiatives
@using BmadPlatform.Application.Features.Initiatives.DeleteInitiative
@using BmadPlatform.Application.Features.Initiatives.GetInitiative
@using BmadPlatform.Domain.Initiatives
@inject IMediator Mediator
@inject NavigationManager Navigation

<PageTitle>@(details?.Name ?? "Iniciativa") · Plataforma BMAD</PageTitle>

@if (loading)
{
    <p class="text-sm text-ink-muted" role="status">Cargando…</p>
}
else if (details is null)
{
    <InitiativeNotFound />
}
else
{
    <a href="/iniciativas" class="text-sm font-medium text-ink-muted hover:text-ink hover:underline">← Volver a iniciativas</a>

    <section class="mt-4 rounded-card border border-line bg-surface-raised p-6 shadow-card sm:p-8">
        <div class="flex flex-wrap items-start justify-between gap-4">
            <div class="min-w-0">
                <h1 class="break-words text-2xl font-semibold text-ink">@details.Name</h1>
                <p class="mt-2"><StatusBadge Status="details.Status" /></p>
            </div>
            <div class="flex flex-wrap items-center gap-3">
                @if (details.Status == InitiativeStatus.Draft)
                {
                    <a href="/iniciativas/@details.Id/crear"
                       class="rounded-full bg-primary px-5 py-2 text-sm font-semibold text-on-primary hover:bg-primary-hover">
                        Continuar
                    </a>
                }
                <a href="/iniciativas/@details.Id/editar"
                   class="rounded-full border border-line bg-surface-raised px-5 py-2 text-sm font-medium text-ink hover:bg-surface">
                    Editar
                </a>
                <button type="button" aria-expanded="@(confirmingDelete ? "true" : "false")" aria-controls="delete-panel" disabled="@busy"
                        @onclick="AskDelete"
                        class="rounded-full border border-danger-line bg-surface-raised px-5 py-2 text-sm font-medium text-danger hover:bg-danger-surface disabled:opacity-60">
                    Eliminar
                </button>
            </div>
        </div>

        @if (details.Status == InitiativeStatus.Draft)
        {
            <p class="mt-4 rounded-control bg-primary-soft px-3 py-2 text-sm text-primary-ink">
                Esta iniciativa sigue en borrador. Continúe el asistente de creación para completarla.
            </p>
        }

        @if (errors.Count > 0)
        {
            <div class="mt-4">
                <ErrorAlert Id="detail-errors" Messages="errors" />
            </div>
        }

        @if (confirmingDelete)
        {
            <div id="delete-panel" role="group" aria-labelledby="delete-title" aria-describedby="delete-text"
                 class="mt-4 rounded-control border border-danger-line bg-danger-surface p-4">
                <h2 id="delete-title" tabindex="-1" @ref="deleteTitle" class="text-base font-semibold text-danger">¿Eliminar esta iniciativa?</h2>
                <p id="delete-text" class="mt-1 text-sm text-ink">La iniciativa dejará de aparecer en su lista y no podrá recuperarla desde la plataforma.</p>
                <div class="mt-4 flex flex-wrap gap-3">
                    <button type="button" disabled="@busy" @onclick="DeleteAsync"
                            class="rounded-full bg-danger px-5 py-2 text-sm font-semibold text-on-primary hover:opacity-90 disabled:opacity-60">
                        Sí, eliminar
                    </button>
                    <button type="button" disabled="@busy" @onclick="CancelDelete"
                            class="rounded-full border border-line bg-surface-raised px-5 py-2 text-sm font-medium text-ink hover:bg-surface disabled:opacity-60">
                        Cancelar
                    </button>
                </div>
            </div>
        }

        <dl class="mt-6 divide-y divide-line rounded-control border border-line text-sm">
            <div class="px-4 py-3">
                <dt class="text-xs font-medium uppercase tracking-wide text-ink-muted">Descripción</dt>
                <dd class="mt-1 whitespace-pre-line break-words text-ink">@(details.Description ?? "Sin descripción")</dd>
            </div>
            <div class="px-4 py-3">
                <dt class="text-xs font-medium uppercase tracking-wide text-ink-muted">Modo de profundidad</dt>
                <dd class="mt-1 text-ink">@(details.DepthMode is { } mode ? InitiativeLabels.Mode(mode) : "Sin elegir")</dd>
            </div>
            <div class="px-4 py-3">
                <dt class="text-xs font-medium uppercase tracking-wide text-ink-muted">Nivel de profundidad</dt>
                <dd class="mt-1 text-ink">
                    @InitiativeLabels.DepthSummary(details.DepthMode, details.Depth)
                    @if (details.Depth is { } level)
                    {
                        <span class="text-ink-muted"> · Entrega: @InitiativeLabels.DeliverablesSummary(level)</span>
                    }
                </dd>
            </div>
            <div class="px-4 py-3">
                <dt class="text-xs font-medium uppercase tracking-wide text-ink-muted">Creada</dt>
                <dd class="mt-1 text-ink"><time datetime="@details.CreatedAt.ToString("O")">@InitiativeLabels.Date(details.CreatedAt)</time></dd>
            </div>
            <div class="px-4 py-3">
                <dt class="text-xs font-medium uppercase tracking-wide text-ink-muted">Última modificación</dt>
                <dd class="mt-1 text-ink"><time datetime="@details.UpdatedAt.ToString("O")">@InitiativeLabels.Date(details.UpdatedAt)</time></dd>
            </div>
        </dl>
    </section>

    <div class="mt-6 grid gap-4 md:grid-cols-3">
        @foreach (var section in Placeholders)
        {
            <section aria-labelledby="section-@section.Key" class="rounded-card border border-dashed border-line bg-surface-raised p-5">
                <h2 id="section-@section.Key" class="text-base font-semibold text-ink">@section.Title</h2>
                <p class="mt-1 text-sm text-ink-muted">@section.Description</p>
                <p class="mt-3 inline-block rounded-full bg-bubble px-2.5 py-0.5 text-xs font-semibold text-ink-muted">Disponible próximamente</p>
            </section>
        }
    </div>
}

@code {
    private sealed record Placeholder(string Key, string Title, string Description);

    private static readonly Placeholder[] Placeholders =
    [
        new("conversation", "Conversación", "Aquí hablará con el asistente para aclarar la iniciativa."),
        new("artifacts", "Artefactos", "Aquí encontrará los documentos generados."),
        new("context", "Contexto", "Aquí podrá adjuntar videos, enlaces y notas."),
    ];

    private ElementReference deleteTitle;
    private bool focusDeleteTitle;
    private Guid? loadedId;

    private InitiativeDetails? details;
    private bool loading = true;
    private bool busy;
    private bool confirmingDelete;
    private IReadOnlyList<string> errors = [];

    [Parameter]
    public Guid Id { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (loadedId == Id)
        {
            return;
        }

        loadedId = Id;
        loading = true;
        confirmingDelete = false;
        errors = [];

        details = await Mediator.Send(new GetInitiativeQuery(Id));
        loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusDeleteTitle)
        {
            focusDeleteTitle = false;
            await deleteTitle.FocusAsync();
        }
    }

    private void AskDelete()
    {
        confirmingDelete = true;
        focusDeleteTitle = true;
    }

    private void CancelDelete()
    {
        confirmingDelete = false;
    }

    private async Task DeleteAsync()
    {
        busy = true;
        errors = [];

        try
        {
            await Mediator.Send(new DeleteInitiativeCommand(Id));
            Navigation.NavigateTo("/iniciativas");
        }
        catch (Exception exception) when (UserMessages.TryGet(exception, out var messages))
        {
            errors = messages;
            confirmingDelete = false;

            // Already deleted or never visible to this user: same state as any other missing initiative.
            if (exception is NotFoundException)
            {
                details = null;
            }
        }
        finally
        {
            busy = false;
        }
    }
}
