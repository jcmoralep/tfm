@page "/iniciativas"
@attribute [Authorize]
@using BmadPlatform.Application.Features.Initiatives
@using BmadPlatform.Application.Features.Initiatives.ListInitiatives
@using BmadPlatform.Domain.Initiatives
@inject IMediator Mediator
@inject NavigationManager Navigation

<PageTitle>Iniciativas · Plataforma BMAD</PageTitle>

<div class="flex flex-wrap items-center justify-between gap-4">
    <h1 class="text-2xl font-semibold text-ink">Iniciativas</h1>
    <a href="/iniciativas/nueva"
       class="rounded-full bg-primary px-5 py-2 text-sm font-semibold text-on-primary hover:bg-primary-hover">
        Nueva iniciativa
    </a>
</div>

<form role="search" aria-label="Buscar y filtrar iniciativas" @onsubmit="ApplyAsync" @onsubmit:preventDefault
      class="mt-6 grid gap-4 rounded-card border border-line bg-surface-raised p-4 shadow-card sm:grid-cols-[1fr_12rem_12rem_auto] sm:items-end">
    <div>
        <label for="search" class="block text-sm font-medium text-ink">Buscar por nombre</label>
        <input id="search" type="search" @bind="searchText" maxlength="@ListInitiativesQuery.SearchMaxLength" autocomplete="off"
               aria-describedby="@(errors.Count > 0 ? "list-errors" : null)"
               class="mt-1.5 block w-full rounded-control border border-line bg-surface-raised px-3 py-2 text-sm text-ink" />
    </div>
    <div>
        <label for="status-filter" class="block text-sm font-medium text-ink">Estado</label>
        <select id="status-filter" @bind="statusText" @bind:after="ApplyAsync"
                class="mt-1.5 block w-full rounded-control border border-line bg-surface-raised px-3 py-2 text-sm text-ink">
            <option value="">Todos</option>
            @foreach (var option in InitiativeListCriteria.StatusOptions)
            {
                <option value="@option">@InitiativeLabels.Status(option)</option>
            }
        </select>
    </div>
    <div>
        <label for="depth-filter" class="block text-sm font-medium text-ink">Profundidad</label>
        <select id="depth-filter" @bind="depthText" @bind:after="ApplyAsync"
                class="mt-1.5 block w-full rounded-control border border-line bg-surface-raised px-3 py-2 text-sm text-ink">
            <option value="">Todas</option>
            @foreach (var option in InitiativeListCriteria.DepthOptions)
            {
                <option value="@option">@InitiativeLabels.Depth(option)</option>
            }
        </select>
    </div>
    <button type="submit"
            class="rounded-full bg-primary px-5 py-2 text-sm font-semibold text-on-primary hover:bg-primary-hover">
        Buscar
    </button>
</form>

@if (errors.Count > 0)
{
    <div class="mt-4">
        <ErrorAlert Id="list-errors" Messages="errors" />
    </div>
}

@if (loading)
{
    <p class="mt-6 text-sm text-ink-muted" role="status">Cargando…</p>
}
else if (items.Count == 0 && errors.Count == 0)
{
    <section class="mt-6 rounded-card border border-line bg-surface-raised p-8 text-center shadow-card">
        @if (criteria.IsEmpty)
        {
            <h2 class="text-lg font-semibold text-ink">Aún no tiene iniciativas</h2>
            <p class="mt-2 text-ink-muted">Cree la primera para empezar a darle forma con el asistente.</p>
            <a href="/iniciativas/nueva"
               class="mt-5 inline-block rounded-full bg-primary px-5 py-2 text-sm font-semibold text-on-primary hover:bg-primary-hover">
                Crear iniciativa
            </a>
        }
        else
        {
            <h2 class="text-lg font-semibold text-ink">No hay iniciativas que coincidan</h2>
            <p class="mt-2 text-ink-muted">Pruebe con otro nombre o cambie los filtros.</p>
            <a href="@InitiativeListCriteria.ListPath"
               class="mt-5 inline-block rounded-full border border-line bg-surface-raised px-5 py-2 text-sm font-medium text-ink hover:bg-surface">
                Limpiar búsqueda y filtros
            </a>
        }
    </section>
}
else if (items.Count > 0)
{
    <p class="mt-6 text-sm text-ink-muted" role="status">@(items.Count == 1 ? "1 iniciativa" : $"{items.Count} iniciativas")</p>

    <div class="mt-2 overflow-x-auto rounded-card border border-line bg-surface-raised shadow-card">
        <table class="w-full min-w-[40rem] text-left text-sm">
            <caption class="sr-only">Sus iniciativas, de la modificada más recientemente a la más antigua</caption>
            <thead class="border-b border-line text-xs font-medium uppercase tracking-wide text-ink-muted">
                <tr>
                    <th scope="col" class="px-4 py-3">Nombre</th>
                    <th scope="col" class="px-4 py-3">Estado</th>
                    <th scope="col" class="px-4 py-3">Profundidad</th>
                    <th scope="col" class="px-4 py-3">Modificada</th>
                    <th scope="col" class="px-4 py-3"><span class="sr-only">Acción</span></th>
                </tr>
            </thead>
            <tbody class="divide-y divide-line">
                @foreach (var item in items)
                {
                    var isDraft = item.Status == InitiativeStatus.Draft;
                    <tr>
                        <th scope="row" class="px-4 py-3 font-medium text-ink">
                            <a href="@(isDraft ? $"/iniciativas/{item.Id}/crear" : $"/iniciativas/{item.Id}")" class="hover:underline">@item.Name</a>
                        </th>
                        <td class="px-4 py-3"><StatusBadge Status="item.Status" /></td>
                        <td class="px-4 py-3 text-ink">@InitiativeLabels.DepthSummary(item.DepthMode, item.Depth)</td>
                        <td class="px-4 py-3 text-ink-muted"><time datetime="@item.UpdatedAt.ToString("O")">@InitiativeLabels.Date(item.UpdatedAt)</time></td>
                        <td class="px-4 py-3 text-right">
                            @if (isDraft)
                            {
                                <a href="/iniciativas/@item.Id/crear" class="font-semibold text-primary-ink hover:underline">Continuar<span class="sr-only"> con @item.Name</span></a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private InitiativeListCriteria criteria = new(null, null, null);
    private IReadOnlyList<InitiativeSummary> items = [];
    private IReadOnlyList<string> errors = [];
    private bool loading = true;
    private bool loaded;

    // Local copies of the form controls; they only reach the address (and the list) when applied.
    private string? searchText;
    private string statusText = string.Empty;
    private string depthText = string.Empty;

    [SupplyParameterFromQuery(Name = "q")]
    public string? Search { get; set; }

    [SupplyParameterFromQuery(Name = "estado")]
    public string? Status { get; set; }

    [SupplyParameterFromQuery(Name = "nivel")]
    public string? Depth { get; set; }

    // The address is the source of truth: applying the form navigates, and this reloads for the new address.
    protected override async Task OnParametersSetAsync()
    {
        var requested = InitiativeListCriteria.FromQuery(Search, Status, Depth);
        if (loaded && requested == criteria)
        {
            return;
        }

        criteria = requested;
        searchText = requested.Search;
        statusText = requested.Status?.ToString() ?? string.Empty;
        depthText = requested.Depth?.ToString() ?? string.Empty;

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        errors = [];
        items = [];

        try
        {
            items = await Mediator.Send(new ListInitiativesQuery(criteria.Search, criteria.Status, criteria.Depth));
        }
        catch (Exception exception) when (UserMessages.TryGet(exception, out var messages))
        {
            errors = messages;
        }
        finally
        {
            loading = false;
            loaded = true;
        }
    }

    private Task ApplyAsync()
    {
        var requested = InitiativeListCriteria.FromQuery(searchText, statusText, depthText);

        if (requested == criteria)
        {
            // Same address, so a navigation would not reload: refresh in place.
            return LoadAsync();
        }

        Navigation.NavigateTo(requested.ToRelativeUri());
        return Task.CompletedTask;
    }
}
