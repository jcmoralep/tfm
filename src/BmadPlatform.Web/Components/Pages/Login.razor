@page "/login"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@layout AuthLayout
@using BmadPlatform.Application.Abstractions.Authentication
@using BmadPlatform.Application.Features.Authentication.SignIn
@using BmadPlatform.Web.Authentication
@using FluentValidation
@inject IMediator Mediator
@inject NavigationManager Navigation

<PageTitle>Iniciar sesión · Plataforma BMAD</PageTitle>

<div class="grid min-h-screen lg:grid-cols-2">
    <aside class="flex flex-col gap-10 bg-linear-to-br from-brand-deep to-brand-mid px-6 py-8 text-surface-raised sm:px-12 lg:justify-between lg:px-16 lg:py-12">
        <BrandLogo />

        <div>
            <p class="text-4xl leading-tight tracking-tight sm:text-5xl">
                <span class="font-light">De la idea al desarrollo,</span><br />
                <span class="font-bold">guiado paso a paso</span>
            </p>
            <div class="mt-8 h-0.5 w-16 bg-brand-rule" aria-hidden="true"></div>
        </div>

        <ul class="hidden space-y-7 lg:block">
            <BenefitRow Title="Un asistente que te guía"
                        Description="Te hace las preguntas correctas sobre tu iniciativa, paso a paso, sin que necesites conocimientos técnicos.">
                <Icon><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z" /></Icon>
            </BenefitRow>
            <BenefitRow Title="Artefactos listos para construir"
                        Description="Brief, PRD, Arquitectura y Épicas e historias; los dos últimos como borrador para el equipo de desarrollo.">
                <Icon><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" /><path d="M14 3v5h5M9 14l2 2 4-4" /></Icon>
            </BenefitRow>
            <BenefitRow Title="Aprueba y exporta"
                        Description="Tú apruebas cada artefacto y lo descargas en Markdown para desarrollo o en PDF para ti.">
                <Icon><path d="M12 3v12M7 10l5 5 5-5M5 21h14" /></Icon>
            </BenefitRow>
            <BenefitRow Title="De la idea al desarrollo en un solo lugar"
                        Description="Tu iniciativa y su contexto quedan juntos, listos para pasar a construcción.">
                <Icon><path d="M5 21V4M5 4h11l-2 4 2 4H5" /></Icon>
            </BenefitRow>
        </ul>
    </aside>

    <section class="flex items-center justify-center bg-surface-raised px-6 py-12 sm:px-12">
        <div class="w-full max-w-md">
            <h1 class="text-3xl font-semibold tracking-tight text-ink">Bienvenido a Plataforma BMAD</h1>
            <p class="mt-2 text-base text-ink-muted">Inicia sesión con tu correo electrónico y contraseña.</p>

            @if (errors.Count > 0)
            {
                <div id="login-errors" role="alert" class="mt-6 rounded-control border border-danger-line bg-danger-surface p-3 text-sm text-danger">
                    <ul class="space-y-1">
                        @foreach (var error in errors)
                        {
                            <li>@error</li>
                        }
                    </ul>
                </div>
            }

            <EditForm Model="Input" method="post" OnSubmit="SignInAsync" FormName="login" class="mt-8 space-y-5">
                <div>
                    <label for="email" class="block text-sm font-medium text-ink">Correo electrónico</label>
                    <InputText id="email" type="email" @bind-Value="Input.Email" autocomplete="username" required
                               aria-describedby="@(errors.Count > 0 ? "login-errors" : null)"
                               class="mt-2 block w-full rounded-control border border-line bg-surface px-4 py-3 text-sm text-ink" />
                </div>

                <div>
                    <label for="password" class="block text-sm font-medium text-ink">Contraseña</label>
                    <div class="relative mt-2">
                        <InputText id="password" type="password" @bind-Value="Input.Password" autocomplete="current-password" required
                                   aria-describedby="@(errors.Count > 0 ? "login-errors" : null)"
                                   class="block w-full rounded-control border border-line bg-surface py-3 pl-4 pr-12 text-sm text-ink" />
                        @* Hidden until wwwroot/js/password-toggle.js runs: this static page has no interactive circuit. *@
                        <button type="button" data-password-toggle aria-controls="password" aria-pressed="false" aria-label="Mostrar contraseña"
                                class="absolute inset-y-0 right-0 hidden w-12 place-items-center rounded-control text-ink-muted hover:text-ink data-[ready]:grid">
                            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"
                                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                                <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z" /><circle cx="12" cy="12" r="3" />
                            </svg>
                            <svg class="hidden size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"
                                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                                <path d="M3 3l18 18M10.6 5.1A10 10 0 0 1 12 5c6.5 0 10 7 10 7a17 17 0 0 1-3.2 4M6.5 6.6C3.7 8.4 2 12 2 12s3.5 7 10 7a9.7 9.7 0 0 0 4.2-.9M9.9 9.9a3 3 0 0 0 4.2 4.2" />
                            </svg>
                        </button>
                    </div>
                </div>

                <label class="flex cursor-pointer items-center justify-between gap-4 text-sm text-ink-muted">
                    <span>Permanecer conectado</span>
                    <InputCheckbox @bind-Value="Input.RememberMe" class="peer sr-only" />
                    <span aria-hidden="true"
                          class="relative h-6 w-11 shrink-0 rounded-full bg-line ring-1 ring-inset ring-ink-muted/40 transition-colors peer-checked:bg-primary peer-checked:ring-primary peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-focus after:absolute after:left-0.5 after:top-0.5 after:size-5 after:rounded-full after:bg-surface-raised after:shadow-card after:transition-transform peer-checked:after:translate-x-5"></span>
                </label>

                <button type="submit"
                        class="w-full rounded-control bg-primary px-4 py-3 text-sm font-semibold text-on-primary hover:bg-primary-hover">
                    Iniciar sesión
                </button>
            </EditForm>
        </div>
    </section>
</div>

<script type="module" src="@Assets["js/password-toggle.js"]"></script>

@code {
    private IReadOnlyList<string> errors = [];

    [SupplyParameterFromForm]
    private LoginInput Input { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Input ??= new LoginInput();

        if (AuthenticationStateTask is not null
            && (await AuthenticationStateTask).User.Identity?.IsAuthenticated == true)
        {
            Navigation.NavigateTo(LocalRedirect.Sanitize(ReturnUrl), forceLoad: true);
        }
    }

    private async Task SignInAsync()
    {
        AuthenticationResult result;

        try
        {
            result = await Mediator.Send(new SignInCommand(Input.Email, Input.Password, Input.RememberMe));
        }
        catch (ValidationException exception)
        {
            errors = exception.Errors.Select(failure => failure.ErrorMessage).Distinct().ToList();
            Input.Password = string.Empty;
            return;
        }

        if (result == AuthenticationResult.Succeeded)
        {
            Navigation.NavigateTo(LocalRedirect.Sanitize(ReturnUrl), forceLoad: true);
            return;
        }

        errors = [ToMessage(result)];
        Input.Password = string.Empty;
    }

    private static string ToMessage(AuthenticationResult result) => result switch
    {
        AuthenticationResult.LockedOut =>
            "La cuenta está bloqueada temporalmente por varios intentos fallidos. Vuelva a intentarlo más tarde.",
        AuthenticationResult.NotAllowed =>
            "Esta cuenta no tiene permitido iniciar sesión.",
        _ => "El correo electrónico o la contraseña no son correctos.",
    };

    private sealed class LoginInput
    {
        public string Email { get; set; } = string.Empty;

        public string Password { get; set; } = string.Empty;

        public bool RememberMe { get; set; }
    }
}
