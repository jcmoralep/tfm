@using System.Linq.Expressions
@* Password input with the show/hide button. The button stays hidden until wwwroot/js/password-toggle.js runs:
   the login and registration pages are static and have no interactive circuit. *@
<div>
    <label for="@Id" class="block text-sm font-medium text-ink">@Label<RequiredMark /></label>
    <div class="relative mt-2">
        <InputText id="@Id" type="password" Value="@Value" ValueChanged="@ValueChanged" ValueExpression="@ValueExpression"
                   autocomplete="@Autocomplete" required aria-describedby="@DescribedBy"
                   class="block w-full rounded-control border border-line bg-surface py-3 pl-4 pr-12 text-sm text-ink" />
        <button type="button" data-password-toggle aria-controls="@Id" aria-pressed="false" aria-label="Mostrar contraseña"
                class="absolute inset-y-0 right-0 hidden w-12 place-items-center rounded-control text-ink-muted hover:text-ink data-[ready]:grid">
            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z" /><circle cx="12" cy="12" r="3" />
            </svg>
            <svg class="hidden size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <path d="M3 3l18 18M10.6 5.1A10 10 0 0 1 12 5c6.5 0 10 7 10 7a17 17 0 0 1-3.2 4M6.5 6.6C3.7 8.4 2 12 2 12s3.5 7 10 7a9.7 9.7 0 0 0 4.2-.9M9.9 9.9a3 3 0 0 0 4.2 4.2" />
            </svg>
        </button>
    </div>
    @if (Hint is not null)
    {
        <p class="mt-2 text-sm text-ink-muted">@Hint</p>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public string Id { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Autocomplete { get; set; } = string.Empty;

    [Parameter]
    public string? DescribedBy { get; set; }

    /// <summary>Optional helper text shown under the field.</summary>
    [Parameter]
    public string? Hint { get; set; }

    [Parameter]
    public string Value { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    [Parameter]
    public Expression<Func<string>>? ValueExpression { get; set; }
}
