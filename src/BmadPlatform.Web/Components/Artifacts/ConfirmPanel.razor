@implements IAsyncDisposable
@inject IJSRuntime JS
@* Confirmation shown as a modal window (native <dialog>, opened by wwwroot/js/confirm-dialog.js): the page behind is
   inert, focus stays inside and moves to the title when it opens, Escape and a click on the backdrop cancel it.
   Red tone for destructive actions, blue for the rest. *@
<dialog @ref="dialog" id="@Id" aria-labelledby="@TitleId" aria-describedby="@TextId"
        class="m-auto w-[calc(100%-2rem)] max-w-md rounded-card border bg-surface-raised p-0 text-ink shadow-card backdrop:bg-ink/50 @(Destructive ? "border-danger-line" : "border-line")">
    <div class="p-5">
        <h2 id="@TitleId" tabindex="-1" data-dialog-title
            class="text-base font-semibold @(Destructive ? "text-danger" : "text-primary-ink")">@Title</h2>
        <div id="@TextId" class="mt-2 text-sm text-ink">@ChildContent</div>
        <div class="mt-5 flex flex-wrap justify-end gap-3">
            <button type="button" disabled="@Busy" @onclick="OnCancel"
                    class="rounded-full border border-line bg-surface-raised px-5 py-2 text-sm font-medium text-ink hover:bg-surface disabled:opacity-60">
                Cancelar
            </button>
            <button type="button" disabled="@Busy" @onclick="OnConfirm"
                    class="rounded-full px-5 py-2 text-sm font-semibold text-on-primary disabled:opacity-60 @(Destructive ? "bg-danger hover:opacity-90" : "bg-primary hover:bg-primary-hover")">
                @ConfirmLabel
            </button>
        </div>
    </div>
</dialog>

@code {
    private ElementReference dialog;
    private IJSObjectReference? module;
    private DotNetObjectReference<ConfirmPanel>? handler;

    [Parameter, EditorRequired]
    public string Id { get; set; } = "confirm-panel";

    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string ConfirmLabel { get; set; } = string.Empty;

    /// <summary>Red window for actions that lose something (delete, regenerate); blue otherwise (approve).</summary>
    [Parameter]
    public bool Destructive { get; set; }

    /// <summary>True while the confirmed operation runs: both buttons are disabled so it cannot be sent twice.</summary>
    [Parameter]
    public bool Busy { get; set; }

    [Parameter]
    public EventCallback OnConfirm { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private string TitleId => Id + "-title";

    private string TextId => Id + "-text";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Runs only in the interactive render: the window is created after a click, so prerendering never touches JavaScript.
        if (!firstRender)
        {
            return;
        }

        try
        {
            module = await JS.InvokeAsync<IJSObjectReference>("import", "./" + Assets["js/confirm-dialog.js"]);
            handler = DotNetObjectReference.Create(this);
            await module.InvokeVoidAsync("open", dialog, handler);
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone; there is nothing left to open.
        }
    }

    /// <summary>Called by the script when Escape is pressed or the backdrop is clicked.</summary>
    [JSInvokable]
    public async Task Dismiss()
    {
        if (!Busy)
        {
            await OnCancel.InvokeAsync();
        }
    }

    public async ValueTask DisposeAsync()
    {
        handler?.Dispose();

        if (module is null)
        {
            return;
        }

        try
        {
            await module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone; the browser already released the module.
        }
    }
}
