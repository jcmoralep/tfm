@using BmadPlatform.Application.Features.Artifacts.Markdown

@* Presentational panel of the open questions. It owns only the field state: the rows and the version are copied once
   in OnInitialized, so a conflict leaves the typed values and the stale base version in place (a retry conflicts
   again until the page renders a new panel, which it does after a successful write or Cancelar). It decides nothing
   about the rules; the command validates and rewrites. *@

<section aria-labelledby="questions-title" class="mt-6 rounded-control border border-line bg-surface p-4">
    <h2 id="questions-title" class="text-base font-semibold text-ink">@ArtifactLabels.QuestionsTitle</h2>
    <p id="questions-intro" class="mt-1 text-sm text-ink-muted">@ArtifactLabels.QuestionsIntro</p>
    @if (Hint is not null)
    {
        <p id="questions-hint" class="mt-1 text-sm text-warning-ink">@Hint</p>
    }
    <p class="mt-1 text-xs text-ink-muted">
        <span class="text-danger" aria-hidden="true">*</span> @ArtifactLabels.QuestionsRequiredLegend
    </p>

    <datalist id="owner-suggestions">
        @foreach (var suggestion in ArtifactLabels.OwnerSuggestions)
        {
            <option value="@suggestion"></option>
        }
    </datalist>

    <form @onsubmit="SaveAsync" @onsubmit:preventDefault class="mt-4 space-y-4">
        @foreach (var row in rows)
        {
            <fieldset @key="row.Id" class="rounded-control border border-line bg-surface-raised p-3">
                <legend class="px-1 text-sm font-medium text-ink">
                    <span class="font-semibold">@row.Id</span>
                    <span class="break-words">@row.Text</span>
                    @if (!row.Assigned)
                    {
                        <span class="ml-1 inline-block rounded-full bg-warning-soft px-2.5 py-0.5 text-xs font-semibold text-warning-ink">@ArtifactLabels.QuestionsUnassigned</span>
                    }
                </legend>
                <div class="mt-2 grid gap-3 sm:grid-cols-2">
                    <div>
                        <label for="@OwnerId(row)" class="block text-sm font-medium text-ink">Responsable de @row.Id<RequiredMark /></label>
                        <input id="@OwnerId(row)" type="text" list="owner-suggestions" maxlength="@QuestionOwners.OwnerMaxLength"
                               readonly="@Busy" @bind="row.Owner" @bind:event="oninput" aria-required="true"
                               aria-describedby="@DescribedBy"
                               class="mt-1 block min-h-6 w-full rounded-control border border-line bg-surface-raised px-3 py-2 text-sm text-ink read-only:opacity-60" />
                    </div>
                    <div>
                        <label for="@RevisitId(row)" class="block text-sm font-medium text-ink">Condición de revisión de @row.Id<RequiredMark /></label>
                        <input id="@RevisitId(row)" type="text" maxlength="@QuestionOwners.RevisitMaxLength"
                               placeholder="@ArtifactLabels.OwnerPlaceholderHint"
                               readonly="@Busy" @bind="row.Revisit" @bind:event="oninput" aria-required="true"
                               aria-describedby="@DescribedBy"
                               class="mt-1 block min-h-6 w-full rounded-control border border-line bg-surface-raised px-3 py-2 text-sm text-ink read-only:opacity-60" />
                    </div>
                </div>
            </fieldset>
        }

        <div class="flex flex-wrap gap-3">
            <button type="submit" disabled="@(Busy || !CanAct)"
                    class="rounded-full bg-primary px-5 py-2 text-sm font-semibold text-on-primary hover:bg-primary-hover disabled:opacity-60">
                Guardar
            </button>
            <button type="button" disabled="@(Busy || !CanAct)" @onclick="CancelAsync"
                    class="rounded-full border border-line bg-surface-raised px-5 py-2 text-sm font-medium text-ink hover:bg-surface disabled:opacity-60">
                Cancelar
            </button>
        </div>
    </form>
</section>

@code {
    private List<QuestionRow> rows = [];
    private int baseVersion;
    private bool interactive;

    [Parameter, EditorRequired]
    public IReadOnlyList<OpenQuestion> Questions { get; set; } = [];

    /// <summary>The version the questions were read from; the save is sent against it.</summary>
    [Parameter, EditorRequired]
    public int Version { get; set; }

    /// <summary>True while any write of the page runs: the fields become read-only and the buttons are disabled.</summary>
    [Parameter]
    public bool Busy { get; set; }

    /// <summary>False when the page does not allow editing this document.</summary>
    [Parameter]
    public bool Enabled { get; set; } = true;

    /// <summary>What saving undoes for an approved document; null for a draft.</summary>
    [Parameter]
    public string? Hint { get; set; }

    /// <summary>True when the page shows the red error alert (<c>doc-errors</c>), so the fields can point to it.</summary>
    [Parameter]
    public bool HasErrors { get; set; }

    [Parameter]
    public EventCallback<QuestionOwnersSubmission> OnSave { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    // Buttons stay disabled until the circuit is interactive, so a click cannot be lost while prerendered.
    private bool CanAct => Enabled && interactive;

    private string DescribedBy => "questions-intro" + (Hint is not null ? " questions-hint" : null) + (HasErrors ? " doc-errors" : null);

    protected override void OnInitialized()
    {
        rows = QuestionRows.From(Questions);
        baseVersion = Version;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            interactive = true;
            StateHasChanged();
        }
    }

    private static string OwnerId(QuestionRow row) => $"question-owner-{row.Id}";

    private static string RevisitId(QuestionRow row) => $"question-revisit-{row.Id}";

    private async Task SaveAsync()
    {
        if (Busy || !CanAct)
        {
            return;
        }

        await OnSave.InvokeAsync(QuestionRows.ToSubmission(baseVersion, rows));
    }

    private async Task CancelAsync()
    {
        if (!Busy)
        {
            await OnCancel.InvokeAsync();
        }
    }
}
