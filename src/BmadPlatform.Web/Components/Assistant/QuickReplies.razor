@using BmadPlatform.Domain.Assistant

@if (Replies.Count > 0)
{
    <div role="group" aria-label="@AssistantLabels.QuickRepliesLabel" class="flex flex-wrap gap-2">
        @foreach (var reply in Replies)
        {
            <button type="button" disabled="@Disabled" @onclick="() => OnSelected.InvokeAsync(reply)" @key="reply.Key"
                    class="rounded-full border border-primary bg-surface-raised px-4 py-2 text-sm font-medium text-primary-ink hover:bg-primary-soft disabled:cursor-not-allowed disabled:opacity-60">
                @reply.Label
            </button>
        }
    </div>
}

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<QuickReply> Replies { get; set; } = [];

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback<QuickReply> OnSelected { get; set; }
}
