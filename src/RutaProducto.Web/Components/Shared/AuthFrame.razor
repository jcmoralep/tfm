@* Split layout shared by the auth pages added after login and registration: the showcase on the left, one narrow column on the right. *@
<div class="grid min-h-screen lg:grid-cols-2">
    <AuthShowcase />

    <section class="flex items-center justify-center bg-surface-raised px-6 py-12 sm:px-12">
        <div class="w-full max-w-md">
            @ChildContent
        </div>
    </section>
</div>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
