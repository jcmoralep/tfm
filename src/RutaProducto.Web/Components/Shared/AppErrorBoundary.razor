@inherits ErrorBoundary
@implements IDisposable
@inject ILogger<AppErrorBoundary> Logger
@inject NavigationManager Navigation

@if (CurrentException is null)
{
    @ChildContent
}
else
{
    <section role="alert" class="rounded-card border border-danger-line bg-danger-surface p-8">
        <h1 class="text-xl font-semibold text-danger">Algo salió mal</h1>
        <p class="mt-3 text-ink-muted">
            No fue posible mostrar esta sección. Si estaba escribiendo, es posible que deba volver a introducir los datos.
            Puede reintentar o volver al inicio.
        </p>
        <div class="mt-6 flex items-center gap-4">
            <button type="button" @onclick="Recover"
                    class="rounded-control border border-line bg-surface-raised px-3 py-1.5 text-sm font-medium text-ink hover:bg-surface">
                Reintentar
            </button>
            <a href="" data-enhanced-nav="false" class="text-sm font-semibold text-ink underline">Volver al inicio</a>
        </div>
    </section>
}

@code {
    protected override void OnInitialized() => Navigation.LocationChanged += OnLocationChanged;

    // The boundary lives in the layouts, so it survives navigation: leaving the failed page must clear the error.
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) =>
        _ = InvokeAsync(() =>
        {
            if (CurrentException is not null)
            {
                Recover();
            }
        });

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;

    // The default boundary logs at Warning, which would hide real defects when filtering by Error.
    protected override Task OnErrorAsync(Exception exception)
    {
        Logger.LogError(exception, "Unhandled exception rendering component");
        return Task.CompletedTask;
    }
}
