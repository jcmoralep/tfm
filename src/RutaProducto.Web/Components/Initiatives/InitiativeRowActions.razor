@* Quick actions of an initiative in the list: edit (pencil) and delete (trash, which asks for confirmation in the page).
   "relative z-10" lifts them above the stretched link that makes the whole row or card clickable. *@
<div class="relative z-10 flex items-center gap-1">
    <a href="@EditHref" title="Editar" aria-label="Editar @Name"
       class="grid size-10 place-items-center rounded-full text-ink-muted hover:bg-primary-soft hover:text-primary-ink md:size-9">
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z" />
        </svg>
    </a>
    <button type="button" title="Eliminar" aria-label="Eliminar @Name" disabled="@Disabled" @onclick="OnDelete"
            class="grid size-10 place-items-center rounded-full text-ink-muted hover:bg-danger-surface hover:text-danger disabled:opacity-60 md:size-9">
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M3 6h18M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2M6 6l1 14a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1l1-14M10 11v6M14 11v6" />
        </svg>
    </button>
</div>

@code {
    [Parameter, EditorRequired]
    public string Name { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string EditHref { get; set; } = string.Empty;

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback OnDelete { get; set; }
}
