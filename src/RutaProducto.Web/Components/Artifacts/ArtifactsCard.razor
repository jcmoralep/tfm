@using RutaProducto.Application.Common.Exceptions
@using RutaProducto.Application.Features.Artifacts
@using RutaProducto.Application.Features.Artifacts.GenerateArtifact
@using RutaProducto.Domain.Artifacts
@using RutaProducto.Domain.Common
@inject IMediator Mediator
@inject ILogger<ArtifactsCard> Logger
@inject NavigationManager Navigation
@* The Artefactos card of the initiative detail. ArtifactLabels.Row decides what each row shows; when the overview
   could not be read the card is neutral and offers no action instead of breaking the page. *@

<section aria-labelledby="section-artifacts" class="rounded-card border border-line bg-surface-raised p-5">
    <h2 id="section-artifacts" class="text-base font-semibold text-ink">@ArtifactLabels.CardTitle</h2>

    @if (Overview is null)
    {
        <p class="mt-1 text-sm text-ink-muted">@ArtifactLabels.UnavailableCardText</p>
    }
    else if (Overview.Slots.Count == 0)
    {
        <p class="mt-1 text-sm text-ink-muted">@(Overview.Notice ?? ArtifactLabels.NoDocumentsText)</p>
    }
    else
    {
        <p class="mt-1 text-sm text-ink-muted">@ArtifactLabels.CardIntro</p>

        <ul class="mt-3 divide-y divide-line rounded-control border border-line">
            @foreach (var row in Overview.Slots.Select(ArtifactLabels.Row))
            {
                <li class="flex flex-wrap items-center justify-between gap-x-3 gap-y-2 px-3 py-2.5">
                    <div class="min-w-0">
                        <p class="text-sm font-medium text-ink">@row.Label</p>
                        @if (row.Type is { } helpType)
                        {
                            <p class="mt-0.5 text-xs text-ink-muted">@ArtifactLabels.TypeHelp(helpType)</p>
                        }
                        <p class="mt-1">
                            <span class="inline-block rounded-full px-2.5 py-0.5 text-xs font-semibold @ToneClass(row.Tone)">@row.State</span>
                        </p>
                        @if (row.Reason is { } reason)
                        {
                            <p class="mt-1 text-xs text-ink-muted">@reason</p>
                        }
                    </div>
                    @if (row.Action == ArtifactAction.Open && row.Type is { } openType)
                    {
                        <a href="@ArtifactLabels.PagePath(InitiativeId, openType)" aria-label="@(ArtifactLabels.OpenAction + " " + row.Label)"
                           class="rounded-full border border-line bg-surface-raised px-4 py-1.5 text-sm font-medium text-ink hover:bg-surface">
                            @ArtifactLabels.OpenAction
                        </a>
                    }
                    else if (row.Action == ArtifactAction.Generate && row.Type is { } generateType)
                    {
                        <button type="button" disabled="@busy" aria-label="@(ArtifactLabels.GenerateAction + " " + row.Label)"
                                @onclick="() => GenerateAsync(generateType)"
                                class="rounded-full bg-primary px-4 py-1.5 text-sm font-semibold text-on-primary hover:bg-primary-hover disabled:opacity-60">
                            @ArtifactLabels.GenerateAction
                        </button>
                    }
                </li>
            }
        </ul>

        @if (busy)
        {
            <p role="status" class="mt-3 flex items-center gap-2 text-sm text-ink-muted">
                <span class="flex gap-1" aria-hidden="true">
                    <span class="size-1.5 rounded-full bg-primary motion-safe:animate-bounce"></span>
                    <span class="size-1.5 rounded-full bg-primary motion-safe:animate-bounce [animation-delay:150ms]"></span>
                    <span class="size-1.5 rounded-full bg-primary motion-safe:animate-bounce [animation-delay:300ms]"></span>
                </span>
                @ArtifactLabels.Generating
            </p>
        }

        @if (errors.Count > 0)
        {
            <div class="mt-3">
                <ErrorAlert Id="artifacts-errors" Messages="errors" />
            </div>
        }
    }
</section>

@code {
    private bool busy;
    private IReadOnlyList<string> errors = [];

    [Parameter, EditorRequired]
    public Guid InitiativeId { get; set; }

    [Parameter]
    public ArtifactsOverview? Overview { get; set; }

    /// <summary>Raised after a refusal that means the overview is out of date, so the parent reads it again.</summary>
    [Parameter]
    public EventCallback OnChanged { get; set; }

    private static string ToneClass(ArtifactTone tone) => tone switch
    {
        ArtifactTone.Action => "bg-primary-soft text-primary-ink",
        ArtifactTone.InProgress => "bg-warning-soft text-warning-ink",
        ArtifactTone.Done => "bg-success-soft text-success-ink",
        _ => "bg-bubble text-ink-muted",
    };

    private async Task GenerateAsync(ArtifactType type)
    {
        if (busy)
        {
            return;
        }

        busy = true;
        errors = [];

        try
        {
            await Mediator.Send(new GenerateArtifactCommand(InitiativeId, type));
            Navigation.NavigateTo($"{ArtifactLabels.PagePath(InitiativeId, type)}?{ArtifactLabels.GeneratedFlag}=1");
        }
        catch (Exception exception) when (UserMessages.TryGet(exception, out var messages))
        {
            errors = messages;
            busy = false;

            // The document already exists or the rules changed: the row must stop offering Generar.
            if (exception is ConflictException or DomainException or NotFoundException)
            {
                await OnChanged.InvokeAsync();
            }
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            // Type and id only: the exception message could echo document content.
            Logger.LogError("Generating a document of initiative {InitiativeId} failed ({ExceptionType}).", InitiativeId, exception.GetType().Name);
            errors = [ArtifactLabels.ActionFailed];
            busy = false;
            await OnChanged.InvokeAsync();
        }
    }
}
