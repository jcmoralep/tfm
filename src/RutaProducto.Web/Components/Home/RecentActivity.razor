@using RutaProducto.Application.Features.Initiatives.GetDashboard

<section aria-labelledby="recent-title" class="h-full rounded-card border border-line bg-surface-raised p-5 shadow-card">
    <h2 id="recent-title" class="text-lg font-semibold text-ink">Actividad reciente</h2>

    <ul class="mt-3 divide-y divide-line">
        @foreach (var item in Items)
        {
            <li class="flex flex-wrap items-center justify-between gap-x-3 gap-y-1 py-3">
                <a href="@DashboardLabels.OpenHref(item.Id, item.Status)" class="min-w-0 break-words font-medium text-ink hover:underline">@item.Name</a>
                <div class="flex items-center gap-3 text-sm">
                    <StatusBadge Status="item.Status" />
                    <span class="text-ink-muted">@DashboardLabels.RelativeTime(item.UpdatedAt, Now)</span>
                </div>
            </li>
        }
    </ul>
</section>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<DashboardItem> Items { get; set; } = [];

    [Parameter, EditorRequired]
    public DateTimeOffset Now { get; set; }
}
