@* Welcome card. No time-of-day greeting: the server clock is UTC, not the person's. *@
<section class="rounded-card border border-line bg-surface-raised p-6 shadow-card sm:p-8">
    <h1 class="text-2xl font-semibold text-ink">Le damos la bienvenida</h1>
    <p class="mt-2 text-ink-muted">Aquí ve cómo avanzan sus iniciativas y por dónde seguir.</p>

    @if (HasInitiatives)
    {
        <div class="mt-6 flex flex-wrap gap-3">
            <a href="/iniciativas/nueva"
               class="rounded-full bg-primary px-5 py-2 text-sm font-semibold text-on-primary hover:bg-primary-hover">
                Nueva iniciativa
            </a>
            <a href="/iniciativas"
               class="rounded-full border border-line bg-surface-raised px-5 py-2 text-sm font-medium text-ink hover:bg-surface">
                Ver mis iniciativas
            </a>
        </div>
    }
</section>

@code {
    [Parameter]
    public bool HasInitiatives { get; set; }
}
