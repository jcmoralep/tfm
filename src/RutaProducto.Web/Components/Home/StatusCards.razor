@using RutaProducto.Application.Features.Initiatives.GetDashboard

<section aria-labelledby="status-cards-title" class="h-full rounded-card border border-line bg-surface-raised p-5 shadow-card">
    <h2 id="status-cards-title" class="text-lg font-semibold text-ink">Sus iniciativas por estado</h2>
    <p class="mt-1 text-sm text-ink-muted">Toque un estado para ver esas iniciativas.</p>

    <ul class="mt-4 grid gap-3 sm:grid-cols-2">
        @foreach (var item in Counts)
        {
            <li class="relative flex flex-col rounded-control border border-line bg-surface p-4 hover:border-primary focus-within:border-primary">
                <StatusBadge Status="item.Status" />
                <p class="mt-3 text-3xl font-semibold text-ink">@item.Count</p>
                <p class="mt-1 text-sm text-ink-muted">@DashboardLabels.StatusHint(item.Status)</p>
                @* Stretched link: the whole tile opens the list already filtered by this status. *@
                <a href="@(new InitiativeListCriteria(null, item.Status, null).ToRelativeUri())"
                   class="mt-3 text-sm font-semibold text-primary-ink after:absolute after:inset-0 after:content-[''] hover:underline">
                    Ver iniciativas<span class="sr-only"> en estado @InitiativeLabels.Status(item.Status).ToLowerInvariant(): @item.Count</span>
                </a>
            </li>
        }
    </ul>
</section>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<DashboardStatusCount> Counts { get; set; } = [];
}
