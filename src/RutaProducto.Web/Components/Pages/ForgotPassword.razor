@attribute [Route(AuthenticationEndpoints.ForgotPasswordPath)]
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@layout AuthLayout
@using RutaProducto.Application.Abstractions.Email
@using RutaProducto.Application.Features.Authentication
@using RutaProducto.Application.Features.Authentication.ForgotPassword
@using RutaProducto.Web.Authentication
@using FluentValidation
@inject IMediator Mediator
@inject NavigationManager Navigation
@inject AccountEmailSettings EmailSettings

<PageTitle>Recuperar contraseña · Ruta de Producto</PageTitle>

<AuthFrame>
    <h1 class="text-3xl font-semibold tracking-tight text-ink">Recupera tu contraseña</h1>
    <p class="mt-2 text-base text-ink-muted">Escribe el correo con el que te registraste y te enviamos un enlace para elegir una contraseña nueva.</p>

    @if (errors.Count > 0)
    {
        <div id="forgot-errors" role="alert" class="mt-6 rounded-control border border-danger-line bg-danger-surface p-3 text-sm text-danger">
            <ul class="space-y-1">
                @foreach (var error in errors)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    @if (sent)
    {
        @* The same text for an existing and for an unknown address. *@
        <p role="status" class="mt-6 rounded-control bg-success-soft p-4 text-sm font-medium text-success-ink">Si el correo corresponde a una cuenta, te enviamos un enlace para restablecer la contraseña. Vence en 2 horas.</p>
    }

    <EditForm Model="Input" method="post" OnSubmit="SendAsync" FormName="forgot" class="mt-8 space-y-5">
        <div>
            <label for="email" class="block text-sm font-medium text-ink">Correo electrónico<RequiredMark /></label>
            <InputText id="email" type="email" @bind-Value="Input.Email" autocomplete="username" required
                       aria-describedby="@(errors.Count > 0 ? "forgot-errors" : null)"
                       class="mt-2 block w-full rounded-control border border-line bg-surface px-4 py-3 text-sm text-ink" />
        </div>

        <CaptchaWidget />

        <button type="submit"
                class="w-full rounded-control bg-primary px-4 py-3 text-sm font-semibold text-on-primary hover:bg-primary-hover">
            Enviar enlace
        </button>
    </EditForm>

    <p class="mt-6 text-center text-sm text-ink-muted">
        <a href="@AuthenticationEndpoints.LoginPath" data-enhance-nav="false" class="font-semibold text-primary hover:underline">Volver a iniciar sesión</a>
    </p>
</AuthFrame>

@code {
    private const string CaptchaFieldName = "cf-turnstile-response";

    private IReadOnlyList<string> errors = [];

    private bool sent;

    [SupplyParameterFromForm]
    private ForgotInput Input { get; set; } = default!;

    // Same binding as the registration form; if the hyphenated name does not bind, the posted form is read directly.
    [SupplyParameterFromForm(FormName = "forgot", Name = CaptchaFieldName)]
    private string? CaptchaToken { get; set; }

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    protected override void OnInitialized()
    {
        Input ??= new ForgotInput();

        // Without email there is nothing to send: the page does not exist.
        if (!EmailSettings.EmailEnabled)
        {
            Navigation.NavigateTo(AuthenticationEndpoints.NotFoundRedirect, replace: true);
        }
    }

    private async Task SendAsync()
    {
        ForgotPasswordResult result;

        try
        {
            result = await Mediator.Send(new ForgotPasswordCommand(Input.Email, PostedCaptchaToken()));
        }
        catch (ValidationException exception)
        {
            errors = exception.Errors.Select(failure => failure.ErrorMessage).Distinct().ToList();
            return;
        }

        errors = result switch
        {
            ForgotPasswordResult.CaptchaRejected => [CaptchaTexts.Rejected],
            ForgotPasswordResult.CaptchaUnavailable => [CaptchaTexts.Unavailable],
            _ => [],
        };

        sent = result == ForgotPasswordResult.Accepted;

        if (sent)
        {
            Input.Email = string.Empty;
        }
    }

    private string? PostedCaptchaToken()
    {
        if (!string.IsNullOrEmpty(CaptchaToken))
        {
            return CaptchaToken;
        }

        return HttpContext?.Request.HasFormContentType == true
            ? HttpContext.Request.Form[CaptchaFieldName].ToString()
            : null;
    }

    private sealed class ForgotInput
    {
        public string Email { get; set; } = string.Empty;
    }
}
