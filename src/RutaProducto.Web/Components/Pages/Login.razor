@page "/login"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@layout AuthLayout
@using RutaProducto.Application.Abstractions.Authentication
@using RutaProducto.Application.Abstractions.Email
@using RutaProducto.Application.Features.Authentication.SignIn
@using RutaProducto.Web.Authentication
@using FluentValidation
@inject IMediator Mediator
@inject NavigationManager Navigation
@inject AccountEmailSettings EmailSettings

<PageTitle>Iniciar sesión · Ruta de Producto</PageTitle>

<div class="grid min-h-screen lg:grid-cols-2">
    <AuthShowcase />

    <section class="flex items-center justify-center bg-surface-raised px-6 py-12 sm:px-12">
        <div class="w-full max-w-md">
            <h1 class="text-3xl font-semibold tracking-tight text-ink">Bienvenido a Ruta de Producto</h1>
            <p class="mt-2 text-base text-ink-muted">Inicia sesión con tu correo electrónico y contraseña.</p>

            @if (errors.Count > 0)
            {
                <div id="login-errors" role="alert" class="mt-6 rounded-control border border-danger-line bg-danger-surface p-3 text-sm text-danger">
                    <ul class="space-y-1">
                        @foreach (var error in errors)
                        {
                            <li>@error</li>
                        }
                    </ul>
                    @if (showResendLink)
                    {
                        <a href="@AuthenticationEndpoints.ResendConfirmationPath" data-enhance-nav="false"
                           class="mt-2 inline-block font-semibold underline">Pedir un enlace nuevo</a>
                    }
                </div>
            }

            <EditForm Model="Input" method="post" OnSubmit="SignInAsync" FormName="login" class="mt-8 space-y-5">
                <div>
                    <label for="email" class="block text-sm font-medium text-ink">Correo electrónico<RequiredMark /></label>
                    <InputText id="email" type="email" @bind-Value="Input.Email" autocomplete="username" required
                               aria-describedby="@(errors.Count > 0 ? "login-errors" : null)"
                               class="mt-2 block w-full rounded-control border border-line bg-surface px-4 py-3 text-sm text-ink" />
                </div>

                <PasswordField Id="password" Label="Contraseña" Autocomplete="current-password"
                               DescribedBy="@(errors.Count > 0 ? "login-errors" : null)"
                               @bind-Value="Input.Password" />

                @if (EmailSettings.EmailEnabled)
                {
                    <a href="@AuthenticationEndpoints.ForgotPasswordPath" data-enhance-nav="false"
                       class="block text-sm font-semibold text-primary hover:underline">¿Olvidaste tu contraseña?</a>
                }

                <label class="flex cursor-pointer items-center justify-between gap-4 text-sm text-ink-muted">
                    <span>Permanecer conectado</span>
                    <InputCheckbox @bind-Value="Input.RememberMe" class="peer sr-only" />
                    <span aria-hidden="true"
                          class="relative h-6 w-11 shrink-0 rounded-full bg-line ring-1 ring-inset ring-ink-muted/40 transition-colors peer-checked:bg-primary peer-checked:ring-primary peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-focus after:absolute after:left-0.5 after:top-0.5 after:size-5 after:rounded-full after:bg-surface-raised after:shadow-card after:transition-transform peer-checked:after:translate-x-5"></span>
                </label>

                <button type="submit"
                        class="w-full rounded-control bg-primary px-4 py-3 text-sm font-semibold text-on-primary hover:bg-primary-hover">
                    Iniciar sesión
                </button>
            </EditForm>

            <p class="mt-6 text-center text-sm text-ink-muted">
                ¿Todavía no tienes cuenta?
                <a href="@RegisterHref" data-enhance-nav="false" class="font-semibold text-primary hover:underline">Crea una cuenta</a>
            </p>
        </div>
    </section>
</div>

<script type="module" src="@Assets["js/password-toggle.js"]"></script>

@code {
    private IReadOnlyList<string> errors = [];

    private bool showResendLink;

    [SupplyParameterFromForm]
    private LoginInput Input { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private string RegisterHref => LocalRedirect.WithReturnUrl(AuthenticationEndpoints.RegisterPath, ReturnUrl);

    protected override async Task OnInitializedAsync()
    {
        Input ??= new LoginInput();

        if (AuthenticationStateTask is not null
            && (await AuthenticationStateTask).User.Identity?.IsAuthenticated == true)
        {
            Navigation.NavigateTo(LocalRedirect.Sanitize(ReturnUrl), forceLoad: true);
        }
    }

    private async Task SignInAsync()
    {
        AuthenticationResult result;

        try
        {
            result = await Mediator.Send(new SignInCommand(Input.Email, Input.Password, Input.RememberMe));
        }
        catch (ValidationException exception)
        {
            errors = exception.Errors.Select(failure => failure.ErrorMessage).Distinct().ToList();
            Input.Password = string.Empty;
            return;
        }

        if (result == AuthenticationResult.Succeeded)
        {
            Navigation.NavigateTo(LocalRedirect.Sanitize(ReturnUrl), forceLoad: true);
            return;
        }

        errors = [ToMessage(result)];
        showResendLink = result == AuthenticationResult.NotAllowed && EmailSettings.EmailEnabled;
        Input.Password = string.Empty;
    }

    private static string ToMessage(AuthenticationResult result) => result switch
    {
        AuthenticationResult.LockedOut =>
            "La cuenta está bloqueada temporalmente por varios intentos fallidos. Vuelva a intentarlo más tarde.",
        AuthenticationResult.NotAllowed =>
            "Confirma tu correo antes de iniciar sesión.",
        _ => "El correo electrónico o la contraseña no son correctos.",
    };

    private sealed class LoginInput
    {
        public string Email { get; set; } = string.Empty;

        public string Password { get; set; } = string.Empty;

        public bool RememberMe { get; set; }
    }
}
