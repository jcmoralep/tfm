@attribute [Route(AuthenticationEndpoints.ResetPasswordPath)]
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@layout AuthLayout
@using RutaProducto.Application.Abstractions.Authentication
@using RutaProducto.Application.Abstractions.Email
@using RutaProducto.Application.Features.Authentication.ResetPassword
@using RutaProducto.Web.Authentication
@using FluentValidation
@inject IMediator Mediator
@inject NavigationManager Navigation
@inject AccountEmailSettings EmailSettings

<PageTitle>Restablecer contraseña · Ruta de Producto</PageTitle>

<AuthFrame>
    @if (done)
    {
        <h1 class="text-3xl font-semibold tracking-tight text-ink">Contraseña actualizada</h1>
        <p role="status" class="mt-6 rounded-control bg-success-soft p-4 text-sm font-medium text-success-ink">Tu contraseña quedó actualizada. Ya puedes iniciar sesión con la nueva.</p>
        <a href="@AuthenticationEndpoints.LoginPath" data-enhance-nav="false"
           class="mt-6 block w-full rounded-control bg-primary px-4 py-3 text-center text-sm font-semibold text-on-primary hover:bg-primary-hover">Iniciar sesión</a>
    }
    else if (invalidLink)
    {
        <h1 class="text-3xl font-semibold tracking-tight text-ink">No pudimos restablecer tu contraseña</h1>
        <p role="alert" class="mt-6 rounded-control border border-danger-line bg-danger-surface p-3 text-sm text-danger">El enlace no es válido o venció. Pide uno nuevo.</p>
        <a href="@AuthenticationEndpoints.ForgotPasswordPath" data-enhance-nav="false"
           class="mt-6 block text-sm font-semibold text-primary hover:underline">Pedir un enlace nuevo</a>
    }
    else
    {
        <h1 class="text-3xl font-semibold tracking-tight text-ink">Elige una contraseña nueva</h1>
        <p class="mt-2 text-base text-ink-muted">Escríbela dos veces para confirmarla.</p>

        @if (errors.Count > 0)
        {
            <div id="reset-errors" role="alert" class="mt-6 rounded-control border border-danger-line bg-danger-surface p-3 text-sm text-danger">
                <ul class="space-y-1">
                    @foreach (var error in errors)
                    {
                        <li>@error</li>
                    }
                </ul>
            </div>
        }

        @* No action attribute: the browser posts to the current URL, so usuario and codigo stay in the query. *@
        <EditForm Model="Input" method="post" OnSubmit="ResetAsync" FormName="reset" class="mt-8 space-y-5">
            <PasswordField Id="password" Label="Contraseña nueva" Autocomplete="new-password"
                           DescribedBy="@("password-rules" + (errors.Count > 0 ? " reset-errors" : null))"
                           @bind-Value="Input.Password">
                <PasswordRules SourceId="password" />
            </PasswordField>

            <PasswordField Id="confirm-password" Label="Repite la contraseña" Autocomplete="new-password"
                           DescribedBy="@("password-match" + (errors.Count > 0 ? " reset-errors" : null))"
                           @bind-Value="Input.ConfirmPassword">
                <p id="password-match" role="status" data-password-match data-source="password" data-target="confirm-password"
                   data-ok-text="✓ Las contraseñas coinciden." data-bad-text="✕ Las contraseñas no coinciden." data-state="empty"
                   class="mt-2 text-sm font-medium data-[state=empty]:hidden data-[state=ok]:text-success-ink data-[state=bad]:text-danger"></p>
            </PasswordField>

            <button type="submit"
                    class="w-full rounded-control bg-primary px-4 py-3 text-sm font-semibold text-on-primary hover:bg-primary-hover">
                Cambiar contraseña
            </button>
        </EditForm>
    }
</AuthFrame>

<script type="module" src="@Assets["js/password-toggle.js"]"></script>
<script type="module" src="@Assets["js/password-match.js"]"></script>
<script type="module" src="@Assets["js/password-rules.js"]"></script>

@code {
    private IReadOnlyList<string> errors = [];

    private bool done;

    private bool invalidLink;

    [SupplyParameterFromForm]
    private ResetInput Input { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "usuario")]
    private string? UserId { get; set; }

    [SupplyParameterFromQuery(Name = "codigo")]
    private string? Code { get; set; }

    protected override void OnInitialized()
    {
        Input ??= new ResetInput();

        // Without email no link can exist: the page does not exist.
        if (!EmailSettings.EmailEnabled)
        {
            Navigation.NotFound();
            return;
        }

        invalidLink = string.IsNullOrEmpty(UserId) || string.IsNullOrEmpty(Code);
    }

    private async Task ResetAsync()
    {
        PasswordResetResult result;

        try
        {
            result = await Mediator.Send(new ResetPasswordCommand(UserId ?? string.Empty, Code ?? string.Empty, Input.Password, Input.ConfirmPassword));
        }
        catch (ValidationException exception)
        {
            errors = exception.Errors.Select(failure => failure.ErrorMessage).Distinct().ToList();
            ClearPasswords();
            return;
        }

        switch (result.Status)
        {
            case PasswordResetStatus.Succeeded:
                done = true;
                break;
            case PasswordResetStatus.InvalidLink:
                invalidLink = true;
                break;
            default:
                // A weak password does not consume the link: the form stays so the person can try again.
                errors = result.PasswordErrors;
                ClearPasswords();
                break;
        }
    }

    private void ClearPasswords()
    {
        Input.Password = string.Empty;
        Input.ConfirmPassword = string.Empty;
    }

    private sealed class ResetInput
    {
        public string Password { get; set; } = string.Empty;

        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
