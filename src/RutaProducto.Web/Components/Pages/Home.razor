@page "/"
@attribute [Authorize]
@using RutaProducto.Application.Features.Initiatives.GetDashboard
@using RutaProducto.Web.Components.Home
@inject IMediator Mediator
@inject TimeProvider Clock

<PageTitle>Inicio · Ruta de Producto</PageTitle>

<div class="space-y-6">
    <DashboardHero HasInitiatives="@(view is { Total: > 0 })" />

    @if (errors.Count > 0)
    {
        <ErrorAlert Id="dashboard-errors" Messages="errors" />
    }
    else if (view is null)
    {
        <p class="text-sm text-ink-muted" role="status">Cargando…</p>
    }
    else if (view.Total == 0)
    {
        <DashboardEmpty />
    }
    else
    {
        @* One 12-column grid; every row splits 7/5 so the edges line up from top to bottom. *@
        <div class="grid gap-6 lg:grid-cols-12">
            <div class="lg:col-span-7"><StatusCards Counts="view.StatusCounts" /></div>
            <div class="lg:col-span-5"><KpiStrip View="view" /></div>

            <div class="lg:col-span-7"><ResumeList Items="view.Resume" Now="now" /></div>
            <div class="lg:col-span-5"><RecentActivity Items="view.Recent" Now="now" /></div>

            <div class="lg:col-span-7"><ActivityChart Weeks="view.Weeks" /></div>
            <div class="lg:col-span-5"><DepthBars Depths="view.Depths" /></div>
        </div>
    }
</div>

@code {
    private DashboardView? view;
    private IReadOnlyList<string> errors = [];
    private DateTimeOffset now;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            now = Clock.GetUtcNow();
            view = await Mediator.Send(new GetDashboardQuery());
        }
        catch (Exception exception) when (UserMessages.TryGet(exception, out var messages))
        {
            errors = messages;
        }
    }
}
