@attribute [Route(AuthenticationEndpoints.ResendConfirmationPath)]
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@layout AuthLayout
@using RutaProducto.Application.Abstractions.Email
@using RutaProducto.Application.Features.Authentication.ResendConfirmation
@using RutaProducto.Web.Authentication
@using FluentValidation
@inject IMediator Mediator
@inject NavigationManager Navigation
@inject AccountEmailSettings EmailSettings

<PageTitle>Reenviar confirmación · Ruta de Producto</PageTitle>

<AuthFrame>
    <h1 class="text-3xl font-semibold tracking-tight text-ink">Confirma tu correo</h1>
    <p class="mt-2 text-base text-ink-muted">Escribe el correo con el que te registraste y te enviamos un enlace nuevo.</p>

    @if (errors.Count > 0)
    {
        <div id="resend-errors" role="alert" class="mt-6 rounded-control border border-danger-line bg-danger-surface p-3 text-sm text-danger">
            <ul class="space-y-1">
                @foreach (var error in errors)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    @if (sent)
    {
        <p role="status" class="mt-6 rounded-control bg-success-soft p-4 text-sm font-medium text-success-ink">Si hay una cuenta pendiente de confirmar con ese correo, te enviamos un enlace nuevo.</p>
    }

    <EditForm Model="Input" method="post" OnSubmit="ResendAsync" FormName="resend" class="mt-8 space-y-5">
        <div>
            <label for="email" class="block text-sm font-medium text-ink">Correo electrónico<RequiredMark /></label>
            <InputText id="email" type="email" @bind-Value="Input.Email" autocomplete="username" required
                       aria-describedby="@(errors.Count > 0 ? "resend-errors" : null)"
                       class="mt-2 block w-full rounded-control border border-line bg-surface px-4 py-3 text-sm text-ink" />
        </div>

        <button type="submit"
                class="w-full rounded-control bg-primary px-4 py-3 text-sm font-semibold text-on-primary hover:bg-primary-hover">
            Enviar enlace
        </button>
    </EditForm>

    <p class="mt-6 text-center text-sm text-ink-muted">
        <a href="@AuthenticationEndpoints.LoginPath" data-enhance-nav="false" class="font-semibold text-primary hover:underline">Volver a iniciar sesión</a>
    </p>
</AuthFrame>

@code {
    private IReadOnlyList<string> errors = [];

    private bool sent;

    [SupplyParameterFromForm]
    private ResendInput Input { get; set; } = default!;

    protected override void OnInitialized()
    {
        Input ??= new ResendInput();

        // Without email there is nothing to resend: the page does not exist.
        if (!EmailSettings.EmailEnabled)
        {
            Navigation.NotFound();
        }
    }

    private async Task ResendAsync()
    {
        try
        {
            await Mediator.Send(new ResendConfirmationCommand(Input.Email));
        }
        catch (ValidationException exception)
        {
            errors = exception.Errors.Select(failure => failure.ErrorMessage).Distinct().ToList();
            return;
        }

        // The same text for an unknown, a confirmed and a pending address.
        sent = true;
        Input.Email = string.Empty;
    }

    private sealed class ResendInput
    {
        public string Email { get; set; } = string.Empty;
    }
}
