{
  "Serilog": {
    "Using": [ "Serilog.Sinks.File", "Serilog.Enrichers.Environment", "Serilog.Enrichers.Thread" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft": "Warning", "System": "Warning" }
    },
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "shared": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] [{CorrelationId}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Database": {
    "MySqlServerVersion": "8.4.0"
  },
  "Assistant": {
    "Provider": "Fake"
  },
  "Gemini": {
    "Model": "gemini-3.6-flash",
    "BaseUrl": "https://generativelanguage.googleapis.com/v1beta",
    "ThinkingLevel": "low",
    "TurnTimeoutSeconds": 60,
    "DraftTimeoutSeconds": 120,
    "MaxConcurrentCalls": 2
  },
  "Storage": {
    "Provider": "Local",
    "LocalRootPath": "App_Data/attachments",
    "MaxFileSizeMb": 10
  },
  "RateLimiting": {
    "Enabled": false,
    "PermitLimit": 10,
    "WindowSeconds": 60
  },
  "AllowedHosts": "*"
}
